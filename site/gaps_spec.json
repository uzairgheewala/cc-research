{
 "about": "Site v3 (s24, TEAM-10): the typed gap model the site renders. Values come only from registry keys; a landmark's gap type is derived by site/gapkit.py from its binding value, conservative end, bar and the board's ruler verdict, never written here. Explanation segments come from the explanation ledger (B1, shared schema) when it exists. Design: project doc claude/site-v3-design-2026-10-20.md.",
 "version": 1,
 "tickets": [
  "TEAM-10"
 ],
 "rules": {
  "type_order": [
   "met",
   "measurement",
   "method",
   "comparability",
   "reach"
  ],
  "measurement_max_factor": 10,
  "measurement_note": "A gap whose point estimate clears the bar but whose conservative end does not is a measurement gap only if the interval would need to shrink by at most sqrt(10) (about 10 times the test cases, interval width taken as proportional to 1/sqrt(n)); beyond that the estimate is too close to the bar for more cases to settle it, and the gap counts as a method gap.",
  "states": [
   "unattributed",
   "attributed",
   "mechanism_known",
   "walled",
   "lever_disputed",
   "lever_chosen",
   "acted_on"
  ],
  "understood_from": "mechanism_known",
  "tackled": [
   "lever_chosen",
   "acted_on"
  ],
  "explain_ledger": {
   "key": "q2x.ledger",
   "path": "analysis/results/q2_v3/explain_ledger_dev.json",
   "required": false
  },
  "power": {
   "key": "q2p.power",
   "path": "analysis/results/q2_v3/power_dev.json"
  }
 },
 "plain": {
  "type": {
   "met": "met",
   "measurement": "needs more test cases",
   "method": "needs a better method",
   "comparability": "not comparable yet",
   "reach": "not run yet"
  },
  "state": {
   "unattributed": "not traced yet",
   "attributed": "traced, cause not known",
   "mechanism_known": "cause known",
   "walled": "cause known, cannot be separated with these data",
   "lever_disputed": "cause known, which fix is disputed",
   "lever_chosen": "fix chosen",
   "acted_on": "fixed in the ledger"
  },
  "verdict": {
   "same": "same ruler",
   "adjusted": "adjusted to the same ruler",
   "not_comparable_yet": "measured on a different ruler"
  }
 },
