+
+def wilson_lb(k, n, z=Z95):
+    if n == 0:
+        return 0.0
+    ph = k / n
+    return (ph + z * z / (2 * n) - z * math.sqrt(ph * (1 - ph) / n + z * z / (4 * n * n))) / (1 + z * z / n)
+
+
+def k_min(n, z=Z95):
+    return next(k for k in range(n + 1) if wilson_lb(k, n, z) > 0.5)
+
+
