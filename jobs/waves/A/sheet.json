 "decisions": [
  {
   "if": "pass(M_T_KERNEL) and pass(M_CANARY)",
   "then": "hosts agree: every number of this sheet is read as produced"
  },
  {
   "if": "fail(M_CANARY)",
   "then": "hosts differ (BLAS family or package build): family-2, X4 and X5 numbers are read as this host's; wave B reruns the canary under this host's coretype in the sandbox before comparing with dev numbers"
  },
  {
   "if": "fail(M_TRACE)",
   "then": "tracker errors on Uzair's machine: wave B fixes them first (the sandbox cannot see runs/ and external/, so its own check was not authoritative)"
  },
  {
   "if": "pass(M_X4)",
   "then": "X4: the nonlinear-only class is kernel-detectable; with X1, missed links are explained except the floor; wave B writes the explanation ledger"
  },
  {
   "if": "fail(M_X4)",
   "then": "X4: even a kernel test does not see the nonlinear-only class beyond null; it joins the floor as 'no usable signal at 1,000 rows'"
  },
  {
   "if": "pass(M_X5_P1)",
   "then": "D2-engine: wave B designs a pretrained engine beside GES inside the ledger (audited like GES), and the 0.634 bar becomes comparable"
  },
  {
   "if": "fail(M_X5_P1)",
   "then": "D1 stays the paper's line; the D2-score route (a nonlinear score inside GES) is a wave-B design question only"
  },
  {
   "if": "fail(M_X5_ORD_HI) or fail(M_X5_ORD_LO)",
   "then": "AVICI reads column order: only the shuffled arm is interpreted; report it as an order-sensitivity finding (BEN-07)"
  },
  {
   "if": "pass(M_F2_ER2) and pass(M_F2_ECE)",
   "then": "family 2: precision and calibration transfer; ER-2 / ER-3 reported per family beside CausalArena"
  },
  {
   "if": "fail(M_F2_ECE)",
   "then": "the confidence model is family-specific: calibration is stated per family only"
  },
  {
   "if": "pass(M_CB_K_CELLS) and pass(M_CB_R_CELLS) and pass(M_CB_S1)",
   "then": "BEN-13 S1 passes: wave B writes the shortcut-share table (placement, permutation, echo, literature)"
  },
  {
   "if": "pass(M_CB_K_CELLS) and fail(M_CB_S1)",
   "then": "CausalBench protocol not reproduced: wave B diagnoses with the sensitivity cells; no re-score claim"
  },
  {
   "if": "fail(M_CB_K_CELLS) or fail(M_CB_R_CELLS)",
   "then": "preprocessing counts differ from the paper's: compare the sidecar counts; no BEN-13 claim"
  },
  {
   "if": "pass(M_LIVE06)",
   "then": "refinement v2 runs inside Causal-Copilot on the fork: wave B scores it against BND-08's unmodified runs and the Q1 checkpoint (BND-13) shows the changed pipeline"
  },
  {
   "if": "skipped(LIVE_06)",
   "then": "the live run waited on the branch stubs (or the fork): after the fork, run the sheet again (finished jobs are not repeated)"
  },
  {
   "if": "pass(M_CC_BASE)",
   "then": "the stubs and the branch series ran on BND-08's base image: the branch is compared with BND-08's unmodified runs, as planned"
  },
  {
   "if": "fail(M_CC_BASE)",
   "then": "the base image was rebuilt (packages downloaded again): the branch is compared with LIVE_06M's main control on the same image; BND-08 is history for this comparison"
  },
  {
   "if": "fail(M_CB_FETCH)",
   "then": "the two figshare files were not in Downloads (or failed size / md5): download them in a browser and run the sheet again; FETCHED.json names each file's reason"
  },
  {
   "if": "pass(M_STUB06_ID) and failed(LIVE_06)",
   "then": "the branch series stopped (cap, quota or a crash): plans/results/fork_bld06_live.capped.json says which; rerunning resumes it"
  }
 ],
