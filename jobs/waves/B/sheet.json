 "decisions": [
  {
   "if": "pass(M_V4_G0)",
   "then": "the v4 plumbing reproduces v3's dev number: every v4 dev number is read as produced"
  },
  {
   "if": "fail(M_V4_G0)",
   "then": "the v4 plumbing does not reproduce v3's dev number: no v4 decision is read; wave C finds the difference first"
  },
  {
   "if": "pass(M_V4_G0) and pass(M_V4_ADOPT)",
   "then": "a v4 score clears the pre-registered rule: wave C freezes it (plans/v4_freeze.json) and reads it once on the sealed held-out family (sheet C)"
  },
  {
   "if": "pass(M_V4_G0) and fail(M_V4_ADOPT)",
   "then": "no v4 score clears the rule: v3 stays the kernel; the score lever alone is not enough (TGT-18, BLD-18); wave C turns to the next lever and reads no held-out file"
  },
  {
   "if": "fail(M_V4_Q2)",
   "then": "even the additive score prefers GES's graph to the true one on most files: the remaining gap is not only the score's functional form (discrete children, interactions or search)"
  },
  {
   "if": "fail(M_V4_Q4)",
   "then": "dropping GES's turning phase alone moves dev precision by more than 0.01: candidate gains are read against G1 as well as G0"
  },
  {
   "if": "pass(M_CB_P2) and pass(M_CB_P4)",
   "then": "BEN-13 S2 complete: the score needs the specific genes (P2) and literature networks carry knockdown signal on the statistical metric (P4)"
  },
  {
   "if": "fail(M_CB_P4)",
   "then": "literature networks score no better than random networks of their size: the names channel is weak on the statistical metric"
  },
  {
   "if": "pass(M_V4_SEAL)",
   "then": "the fresh held-out family exists (500 files) and is sealed; its manifest hash is recorded in heldout_seal.json"
  }
 ],
